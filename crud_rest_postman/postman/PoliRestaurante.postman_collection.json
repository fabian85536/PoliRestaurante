{
  "info": {
    "_postman_id": "0c1c2a2a-9d08-4a63-91f8-2c9f1aa98c1d",
    "name": "PoliRestaurante - CRUD REST",
    "description": "CRUD REST para usuarios, productos, meseros, administradores, mesas y pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000" },
    { "key": "demoUrl", "value": "http://127.0.0.1:5001" },
    { "key": "usuarioId", "value": "1" },
    { "key": "productoId", "value": "1" },
    { "key": "meseroId", "value": "1" },
    { "key": "administradorId", "value": "1" },
    { "key": "mesaId", "value": "1" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('usuarioId', pm.response.json().id);"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana\",\n  \"email\": \"ana.{{$guid}}@example.com\"\n}" }, "url": { "raw": "{{baseUrl}}/api/usuarios" } }
        },
        { "name": "Listar usuarios", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/usuarios" } } },
        { "name": "Consultar usuario", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/usuarios/{{usuarioId}}" } } },
        { "name": "Actualizar usuario", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana Actualizada\"\n}" }, "url": { "raw": "{{baseUrl}}/api/usuarios/{{usuarioId}}" } } },
        { "name": "Eliminar usuario", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/usuarios/{{usuarioId}}" } } }
      ]
    },
    {
      "name": "Productos",
      "item": [
