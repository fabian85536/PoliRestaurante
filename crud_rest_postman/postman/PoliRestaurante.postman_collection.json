          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('administradorId', pm.response.json().id_administrador);"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Marta\",\n  \"usuario\": \"marta\",\n  \"contrasena\": \"cambiar-esta-clave\"\n}" }, "url": { "raw": "{{baseUrl}}/api/administradores" } }
        },
        { "name": "Listar administradores", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/administradores" } } },
