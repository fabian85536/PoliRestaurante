        { "name": "Actualizar mesero", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Luis Actualizado\"\n}" }, "url": { "raw": "{{baseUrl}}/api/meseros/{{meseroId}}" } } },
