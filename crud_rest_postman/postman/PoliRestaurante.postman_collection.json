          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Jugo natural\",\n  \"descripcion\": \"Jugo de mango\",\n  \"precio\": 8000,\n  \"disponible\": true\n}" }, "url": { "raw": "{{baseUrl}}/api/productos" } }
        },
        { "name": "Listar productos", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/productos" } } },
        { "name": "Consultar producto", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/productos/{{productoId}}" } } },
        { "name": "Actualizar producto", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"precio\": 9000,\n  \"disponible\": false\n}" }, "url": { "raw": "{{baseUrl}}/api/productos/{{productoId}}" } } },
        { "name": "Eliminar producto", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/productos/{{productoId}}" } } }
      ]
