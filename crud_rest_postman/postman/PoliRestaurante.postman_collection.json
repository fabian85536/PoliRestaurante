        { "name": "Actualizar administrador", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Marta Actualizada\"\n}" }, "url": { "raw": "{{baseUrl}}/api/administradores/{{administradorId}}" } } },
        { "name": "Eliminar administrador", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/administradores/{{administradorId}}" } } }
