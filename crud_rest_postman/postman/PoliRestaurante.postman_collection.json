          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"numero\": 1,\n  \"estado\": \"Libre\"\n}" }, "url": { "raw": "{{baseUrl}}/api/mesas" } }
        },
        { "name": "Listar mesas", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/mesas" } } },
        { "name": "Consultar mesa", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/mesas/{{mesaId}}" } } },
        { "name": "Actualizar mesa", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"estado\": \"Ocupada\"\n}" }, "url": { "raw": "{{baseUrl}}/api/mesas/{{mesaId}}" } } },
        { "name": "Eliminar mesa", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/mesas/{{mesaId}}" } } }
      ]
