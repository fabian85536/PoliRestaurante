          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Luis\",\n  \"usuario\": \"luis\",\n  \"contrasena\": \"cambiar-esta-clave\"\n}" }, "url": { "raw": "{{baseUrl}}/api/meseros" } }
        },
        { "name": "Listar meseros", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/meseros" } } },
